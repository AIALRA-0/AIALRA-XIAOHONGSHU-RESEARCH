{
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "round_coverage", "selection_summary", "shortlist"],
  "properties": {
    "plan": {"type": "object"},
    "round_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds_executed", "unique_notes", "new_unique_by_round", "duplicate_observations", "source_backends", "saturated", "stop_reason", "blocked_reasons"],
      "properties": {
        "rounds_executed": {"type": "integer", "minimum": 3, "maximum": 5},
        "unique_notes": {"type": "integer", "minimum": 1, "maximum": 160},
        "new_unique_by_round": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "integer", "minimum": 0}},
        "duplicate_observations": {"type": "integer", "minimum": 0},
        "source_backends": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["aialra-shopping-browser", "opencli"]}},
        "saturated": {"type": "boolean"},
        "stop_reason": {"type": "string", "minLength": 1, "maxLength": 80},
        "blocked_reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 240}}
      }
    },
    "selection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_observations", "excluded_by_topic", "selected_for_detail"],
      "properties": {
        "input_observations": {"type": "integer", "minimum": 1},
        "excluded_by_topic": {"type": "integer", "minimum": 0},
        "selected_for_detail": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "shortlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "note_id", "title", "author", "published_text", "likes_text", "saves_text", "comments_text", "cover_url", "url", "source_backends", "seen_in_rounds", "matched_queries", "rank_history", "first_seen_at", "last_seen_at"],
        "properties": {
          "candidate_id": {"type": "string"},
          "note_id": {"type": "string"},
          "title": {"type": "string"},
          "author": {"type": "string"},
          "published_text": {"type": "string"},
          "likes_text": {"type": "string"},
          "saves_text": {"type": "string"},
          "comments_text": {"type": "string"},
          "cover_url": {"type": "string"},
          "url": {"type": "string"},
          "source_backends": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["aialra-shopping-browser", "opencli"]}},
          "seen_in_rounds": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
          "matched_queries": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
          "rank_history": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "integer", "minimum": 1}},
          "first_seen_at": {"type": "string"},
          "last_seen_at": {"type": "string"}
        }
      }
    }
  }
}
