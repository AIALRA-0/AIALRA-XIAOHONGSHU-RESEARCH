{
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "round_coverage", "inspection_coverage", "notes"],
  "properties": {
    "plan": {"type": "object"},
    "round_coverage": {"type": "object"},
    "inspection_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes_attempted", "notes_verified", "comments_read", "failed_urls"],
      "properties": {
        "notes_attempted": {"type": "integer", "minimum": 1, "maximum": 20},
        "notes_verified": {"type": "integer", "minimum": 0, "maximum": 20},
        "comments_read": {"type": "integer", "minimum": 0, "maximum": 600},
        "failed_urls": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 3000}}
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_id", "title", "author", "url", "published_at", "content_summary", "image_urls", "search_backends", "detail_backend", "metrics", "claims", "comments", "commercial_signals", "caveats", "evidence_level", "retrieved_at", "seen_in_rounds", "rank_history"],
        "properties": {
          "note_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{12,40}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "author": {"type": "string", "minLength": 1, "maxLength": 160},
          "url": {"type": "string", "minLength": 10, "maxLength": 3000},
          "published_at": {"type": "string", "minLength": 1, "maxLength": 120},
          "content_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
          "image_urls": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 3000}},
          "search_backends": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["opencli", "supported-chrome"]}},
          "detail_backend": {"enum": ["opencli", "supported-chrome"]},
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["likes", "saves", "comments"],
            "properties": {
              "likes": {"type": "string", "maxLength": 80},
              "saves": {"type": "string", "maxLength": 80},
              "comments": {"type": "string", "maxLength": 80}
            }
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "statement", "claim_type", "evidence"],
              "properties": {
                "claim_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "statement": {"type": "string", "minLength": 3, "maxLength": 500},
                "claim_type": {"enum": ["fact", "experience", "recommendation", "warning"]},
                "evidence": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          },
          "comments": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "relation", "related_claim_ids"],
              "properties": {
                "text": {"type": "string", "minLength": 1, "maxLength": 500},
                "relation": {"enum": ["supports", "contradicts", "adds-context", "other"]},
                "related_claim_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
              }
            }
          },
          "commercial_signals": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 240}},
          "caveats": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 240}},
          "evidence_level": {"enum": ["A", "B", "C"]},
          "retrieved_at": {"type": "string", "minLength": 20, "maxLength": 50},
          "seen_in_rounds": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}},
          "rank_history": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
