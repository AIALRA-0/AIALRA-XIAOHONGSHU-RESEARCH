{
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "collection_status", "rounds", "candidates"],
  "properties": {
    "plan": {"type": "object"},
    "collection_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_reason", "blocked_reasons"],
      "properties": {
        "stop_reason": {"enum": ["plan-completed", "saturated", "round-limit", "candidate-limit", "time-limit", "partial"]},
        "blocked_reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 240}}
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round_id", "query", "sort_mode", "source_backend", "retrieved_at", "result_count"],
        "properties": {
          "round_id": {"type": "string", "pattern": "^round-[1-5]$"},
          "query": {"type": "string", "minLength": 2, "maxLength": 180},
          "sort_mode": {"enum": ["comprehensive", "latest", "most-liked", "most-saved", "most-comments"]},
          "source_backend": {"enum": ["aialra-shopping-browser", "opencli"]},
          "retrieved_at": {"type": "string", "minLength": 20, "maxLength": 50},
          "result_count": {"type": "integer", "minimum": 0, "maximum": 160}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "note_id", "round_id", "query", "sort_mode", "source_backend", "result_rank", "title", "author", "published_text", "likes_text", "saves_text", "comments_text", "cover_url", "url", "retrieved_at"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "note_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{12,40}$"},
          "round_id": {"type": "string", "pattern": "^round-[1-5]$"},
          "query": {"type": "string", "minLength": 2, "maxLength": 180},
          "sort_mode": {"enum": ["comprehensive", "latest", "most-liked", "most-saved", "most-comments"]},
          "source_backend": {"enum": ["aialra-shopping-browser", "opencli"]},
          "result_rank": {"type": "integer", "minimum": 1, "maximum": 200},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "author": {"type": "string", "minLength": 1, "maxLength": 160},
          "published_text": {"type": "string", "maxLength": 120},
          "likes_text": {"type": "string", "maxLength": 80},
          "saves_text": {"type": "string", "maxLength": 80},
          "comments_text": {"type": "string", "maxLength": 80},
          "cover_url": {"type": "string", "minLength": 1, "maxLength": 2000},
          "url": {"type": "string", "minLength": 10, "maxLength": 3000},
          "retrieved_at": {"type": "string", "minLength": 20, "maxLength": 50}
        }
      }
    }
  }
}
